# 构建产物
bin/
# 打包目录（根锚定：仅忽略 make release 在仓库根生成的 dist；
# 前端 internal/.../frontend/dist 由该目录下 .gitignore 自行决定，产物入库）
/dist/
# 编译产物二进制（根锚定——非锚定会误匹配 cmd/uapclaw/ 目录）
/uapclaw
*.out
*.test
coverage.html

# 前端依赖目录兜底：各 frontend/.gitignore 负责自身的 dist；node_modules 在此兜底，
# 避免前端目录搬迁后子 .gitignore 随之搬走、残留依赖被 git add -A 带进仓库
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# Go 工具链
vendor/
# 但保留 sqlite-vec 预编译二进制
!vendor/sqlite-vec/

# 工具本地配置（.codebuddy/rules 例外：项目规约需随仓库版本化）
.codebuddy/*
!.codebuddy/rules/

# 日志文件
*.log

# 运行时 task 目录
internal/agent_teams/tools/tasks/task_test-*/

# SQLite 运行时产物
*.db-shm
*.db-wal
internal/agentcore/memory/external/memory.db
tests/integration/agentcore/harness/rails/memory/coding_memory/
tests/integration/agentcore/harness/rails/memory/memory/
tests/integration/swarm/server/adapter/memory.db
internal/agent_teams/tools/index.json
internal/agentcore/retrieval/indexing/processor/parser/images/
tests/integration/cmd/memory.db
coding_memory/uap-claw-go/memory.db
